{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "limitations",
    "handover"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "handover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism_verdict",
        "practical_verdict",
        "evidence_refs",
        "new_information",
        "follow_up_questions"
      ],
      "properties": {
        "mechanism_verdict": {
          "type": "string",
          "enum": [
            "solved",
            "partially_solved",
            "not_solved",
            "inconclusive"
          ]
        },
        "practical_verdict": {
          "type": "string",
          "enum": [
            "solved",
            "partially_solved",
            "not_solved",
            "inconclusive"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "new_information": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "follow_up_questions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "importance",
              "discriminator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "Q1",
                  "Q2"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "importance": {
                "type": "string",
                "minLength": 1
              },
              "discriminator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
