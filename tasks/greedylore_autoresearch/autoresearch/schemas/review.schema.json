{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_version",
    "workflow_checks",
    "evidence_checks",
    "issues",
    "actions",
    "decision"
  ],
  "properties": {
    "analysis_version": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "pass",
        "warning",
        "fail"
      ]
    }
  }
}
